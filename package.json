  "devDependencies": {
    "@angular-devkit/architect": "0.2200.8",
    "@angular-devkit/build-angular": "22.0.8",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/language-service": "22.0.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
